# Copy to .env (never commit it). Only needed for testnet deploys.
# Deployer wallet: becomes the Pela admin. Use a throwaway testnet-only key.
DEPLOYER_PRIVATE_KEY=
# Optional: defaults to the free public endpoint below.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: lets `npx hardhat verify` publish the source on Etherscan.
ETHERSCAN_API_KEY=
