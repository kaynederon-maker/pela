# Copy to .env.local. setup.ps1 generates one for you.
# 32+ random chars; signs the session cookie.
SESSION_SECRET=
# Optional. Leave empty to use the public RPC of the chain in src/lib/contract.json
# (127.0.0.1:8545 for a local deploy, a public Sepolia node for Sepolia).
NEXT_PUBLIC_RPC_URL=
# SQLite file for off-chain profiles. Defaults to ./pela.db
DB_PATH=
# Production only. The exact host users sign in on (e.g. pela.example.com).
# Sign-in messages for any other domain get rejected. Leave empty for local dev.
APP_DOMAIN=
# Set to 1 only when a reverse proxy you control sets X-Forwarded-For.
# Rate limits then go per client IP instead of one shared bucket.
TRUST_PROXY=
